# Copy to .env (git-ignored). Only the owner edits .env.
TRADING_MODE=paper
# LIVE_CONFIRM is intentionally absent. Live mode is an owner-only decision (trading-safety-rules.md §1).
OBSERVE_ONLY_DAYS=3
CAPITAL=25000
MAX_TRADES_PER_DAY=3
DAILY_PROFIT_STOP_PCT=1.5
DAILY_LOSS_STOP_PCT=-1
RISK_PER_TRADE=100
MAX_SWING_POSITIONS=1
MAX_POSITION_VALUE=25000
MAX_ORDERS_PER_SECOND=2
